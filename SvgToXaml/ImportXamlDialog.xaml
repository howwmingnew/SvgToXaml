<Window
    x:Class="SvgToXaml.ImportXamlDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource S.Settings.Import.Title}"
    Width="640"
    Height="480"
    Background="#FF1E1E1E"
    FontFamily="Segoe UI"
    Foreground="#FFCCCCCC"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46" />
            <Setter Property="BorderBrush" Value="#FF555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF505059" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" BasedOn="{StaticResource DialogButton}" TargetType="Button">
            <Setter Property="Background" Value="#FF0E639C" />
            <Setter Property="BorderBrush" Value="#FF1177BB" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="11"
                   Foreground="#FF999999"
                   Text="{DynamicResource S.Settings.Import.Hint}"
                   TextWrapping="Wrap" />
        <Border Grid.Row="1"
                Background="#FF252526"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <TextBox x:Name="XamlInput"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="#FFCCCCCC"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="#FFCCCCCC"
                         HorizontalContentAlignment="Left"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="8"
                         SelectionBrush="#FF264F78"
                         TextAlignment="Left"
                         TextWrapping="NoWrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" />
                <!-- Placeholder: 顯示範例 XAML，TextBox 為空時顯示，輸入即消失。IsHitTestVisible=False 讓點擊穿透到底下的 TextBox。 -->
                <TextBlock x:Name="Placeholder"
                           Padding="8"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#7FCCCCCC"
                           IsHitTestVisible="False"
                           xml:space="preserve">&lt;ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"&gt;

    &lt;!-- 範例 / Sample：可貼上你專案的 design tokens，按 OK 自動匯入 --&gt;
    &lt;!-- 支援 SolidColorBrush 與 Color 兩種型別 --&gt;
    &lt;!-- 顏色格式：#RGB / #ARGB / #RRGGBB / #AARRGGBB 皆可，無 alpha 視為 FF --&gt;

    &lt;SolidColorBrush x:Key="Brand.Primary" Color="#FF0066CC" /&gt;
    &lt;SolidColorBrush x:Key="Brand.Secondary" Color="#FF333333" /&gt;
    &lt;SolidColorBrush x:Key="Status.Success" Color="#FF00AA00" /&gt;
    &lt;Color x:Key="Status.Error"&gt;#FFCC0033&lt;/Color&gt;

&lt;/ResourceDictionary&gt;<TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=XamlInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style></TextBlock>
            </Grid>
        </Border>
        <TextBlock x:Name="ResultText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="#FFE0E0E0" />
        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Click="Cancel_Click"
                    Content="{DynamicResource S.Settings.Btn.Cancel}"
                    Style="{StaticResource DialogButton}" />
            <Button Click="OK_Click"
                    Content="{DynamicResource S.Settings.Btn.OK}"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
